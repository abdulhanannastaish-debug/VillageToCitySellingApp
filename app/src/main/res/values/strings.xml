    <string name="terms_section1_title">1. Seller Account</string>
    <string name="terms_section1_desc">The seller must provide accurate, complete and up-to-date information when creating and maintaining a seller account. The seller is responsible for keeping account information secure.</string>
    <string name="terms_section2_title">2. Seller Verification</string>
    <string name="terms_section2_desc">Seller verification information, including identity and contact details, must be genuine and belong to the actual seller.</string>
    <string name="terms_section3_title">3. Product Listing Rules</string>
    <string name="terms_section3_desc">Sellers must provide correct product names, descriptions, prices and other relevant information.</string>
    <string name="terms_section4_title">4. Product Quality and Authenticity</string>
    <string name="terms_section4_desc">Sellers are responsible for ensuring that products are genuine, safe and accurately described.</string>
    <string name="terms_section5_title">5. Orders and Delivery</string>
    <string name="terms_section5_desc">Sellers are responsible for properly processing customer orders and preparing products for delivery.</string>
    <string name="terms_section6_title">6. Pricing and Payments</string>
    <string name="terms_section6_desc">Sellers must provide accurate product prices and follow the payment, delivery and commission policies.</string>
    <string name="terms_section7_title">7. Seller Responsibilities</string>
    <string name="terms_section7_desc">Sellers must communicate honestly with customers and fulfill accepted orders responsibly.</string>
    <string name="terms_section8_title">8. Prohibited Activities</string>
    <string name="terms_section8_desc">Fraud, impersonation, misleading product information and unauthorized account use are not permitted.</string>
    <string name="terms_section9_title">9. Account Suspension</string>
    <string name="terms_section9_desc">Village to City may suspend or terminate a seller account if these Terms and Conditions are violated.</string>
    <string name="terms_section10_title">10. Privacy and Personal Information</string>
    <string name="terms_section10_desc">Seller information and documents should be used only for legitimate platform purposes.</string>
    <string name="terms_section11_title">11. Changes to Terms</string>
    <string name="terms_section11_desc">These Terms and Conditions may be updated when necessary.</string>
    <string name="terms_section12_title">12. Acceptance of Terms</string>
    <string name="terms_section12_desc">By using the Village to City seller platform, you confirm that you have read and agreed to these Terms and Conditions.</string>
