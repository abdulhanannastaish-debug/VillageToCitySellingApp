<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================================================= -->
        <!-- BUYER INFORMATION -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgBuyerProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_profile"
                android:scaleType="centerCrop"
                android:contentDescription="Buyer profile picture" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/txtBuyerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ali"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtReviewOrderId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Order ID: RGL12345678"
                    android:textColor="#757575"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- RATING -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtReviewRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="⭐ 5.0"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- REVIEW -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtReviewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="&quot;Product quality bohat achi thi...&quot;"
            android:textColor="#424242"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />


        <!-- ================================================= -->
        <!-- DATE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtReviewDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="15 Aug 2026"
            android:textColor="#888888"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>