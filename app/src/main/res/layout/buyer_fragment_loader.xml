<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- ================= HEADER ================= -->

    <include
        android:id="@+id/header"
        layout="@layout/fragment_buyer_home_header"/>


    <!-- ================= HOME CONTENT ================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Search -->

            <include
                layout="@layout/fragment_buyer_search_bar"/>

            <!-- Categories -->

            <include
                layout="@layout/fragment_buyer_categories"/>

            <!-- Featured Products -->

            <include
                layout="@layout/fragment_buyer_home_feature"/>

        </LinearLayout>

    </ScrollView>


    <!-- ================= BOTTOM NAVIGATION ================= -->

    <LinearLayout
        android:id="@+id/bottomnav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:weightSum="4"
        android:background="@color/white"
        android:elevation="10dp">

        <!-- HOME -->

        <LinearLayout
            android:id="@+id/home_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_home_24"
                android:contentDescription="Home"
                app:tint="#4CAF50"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Home"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"/>

        </LinearLayout>


        <!-- CART -->

        <LinearLayout
            android:id="@+id/menu_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_menu_24"
                android:contentDescription="Cart"
                app:tint="#555555"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Cart"
                android:textSize="12sp"
                android:textColor="#555555"/>

        </LinearLayout>


        <!-- ORDERS -->

        <LinearLayout
            android:id="@+id/orders_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/order"
                android:contentDescription="Orders"
                app:tint="#555555"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Orders"
                android:textSize="12sp"
                android:textColor="#555555"/>

        </LinearLayout>


        <!-- PROFILE -->

        <LinearLayout
            android:id="@+id/dashboard_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_dashboard"
                android:contentDescription="Profile"
                app:tint="#555555"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Profile"
                android:textSize="12sp"
                android:textColor="#555555"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>