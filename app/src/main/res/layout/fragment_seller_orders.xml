<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F7"
    android:orientation="vertical">

    <!-- ================= TOP BAR ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/green"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/appbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Section"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ================= ORDER FILTER TABS ================= -->

    <LinearLayout
        android:id="@+id/tabsRow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/white"
        android:elevation="2dp"
        android:orientation="horizontal">

        <!-- ALL -->

        <TextView
            android:id="@+id/tabAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="All"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ACTIVE -->

        <TextView
            android:id="@+id/tabActive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Active"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- DELIVERED -->

        <TextView
            android:id="@+id/tabDelivered"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Delivered"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- CANCELLED -->

        <TextView
            android:id="@+id/tabCancelled"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cancelled"
            android:textColor="#666666"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ================= ORDERS SCROLL AREA ================= -->

    <ScrollView
        android:id="@+id/ordersScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:contentDescription="Orders list"
        tools:ignore="HardcodedText,SpeakableTextPresentCheck">

        <LinearLayout
            android:id="@+id/orderContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

    </ScrollView>

</LinearLayout>