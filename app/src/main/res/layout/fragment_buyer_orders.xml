<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9F7">

    <!-- ================= TOP BAR ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#4CAF50"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvOrdersTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Orders"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ================= ORDERS LIST ================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- ================================================= -->
            <!-- ORDER CARD 1 -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/orderCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">


                    <!-- Product Information -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgOrderProduct1"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="#E8F5E9"
                            android:padding="10dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/baseline_home_24"
                            android:contentDescription="Product image" />


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvOrderProduct1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pure Desi Ghee"
                                android:textColor="#222222"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvOrderId1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Order ID: #ORD1001"
                                android:textColor="#777777"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvOrderDate1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="10 Aug 2026"
                                android:textColor="#777777"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- Divider -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="#E5E5E5" />


                    <!-- Price / Quantity / Status -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvOrderPrice1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Rs 1500"
                            android:textColor="#2E7D32"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOrderQuantity1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Qty: 1"
                            android:textColor="#555555"
                            android:textSize="14sp" />

                    </LinearLayout>


                    <!-- Status -->

                    <TextView
                        android:id="@+id/tvOrderStatus1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="#E8F5E9"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="Confirmed"
                        android:textColor="#2E7D32"
                        android:textSize="13sp"
                        android:textStyle="bold" />


                    <!-- Buttons -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnTrackOrder1"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:text="Track Order"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:backgroundTint="#4CAF50" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnReview1"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:text="Review"
                            android:textAllCaps="false"
                            android:textColor="#4CAF50"
                            android:textStyle="bold"
                            android:backgroundTint="#E8F5E9" />

                    </LinearLayout>


                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnComplaint1"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="Complaint"
                        android:textAllCaps="false"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"
                        android:backgroundTint="#F1F8F2" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>



            <!-- ================================================= -->
            <!-- ORDER CARD 2 -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/orderCard2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgOrderProduct2"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="#E8F5E9"
                            android:padding="10dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/baseline_home_24"
                            android:contentDescription="Product image" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvOrderProduct2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Village Honey"
                                android:textColor="#222222"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvOrderId2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Order ID: #ORD1002"
                                android:textColor="#777777"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvOrderDate2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="08 Aug 2026"
                                android:textColor="#777777"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="#E5E5E5" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvOrderPrice2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Rs 900"
                            android:textColor="#2E7D32"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOrderQuantity2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Qty: 2"
                            android:textColor="#555555"
                            android:textSize="14sp" />

                    </LinearLayout>


                    <TextView
                        android:id="@+id/tvOrderStatus2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="#E8F5E9"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="Delivered"
                        android:textColor="#2E7D32"
                        android:textSize="13sp"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnTrackOrder2"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:text="Track Order"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:backgroundTint="#4CAF50" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnReview2"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:text="Review"
                            android:textAllCaps="false"
                            android:textColor="#4CAF50"
                            android:textStyle="bold"
                            android:backgroundTint="#E8F5E9" />

                    </LinearLayout>


                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnComplaint2"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="Complaint"
                        android:textAllCaps="false"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"
                        android:backgroundTint="#F1F8F2" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


        </LinearLayout>

    </ScrollView>

    <!-- ================= BOTTOM NAVIGATION ================= -->

    <LinearLayout
        android:id="@+id/bottomnav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:weightSum="4"
        android:background="@color/white"
        android:elevation="10dp">

        <!-- HOME -->

        <LinearLayout
            android:id="@+id/home_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_home_24"
                android:contentDescription="Home"
                app:tint="#4CAF50"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Home"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"/>

        </LinearLayout>


        <!-- CART -->

        <LinearLayout
            android:id="@+id/menu_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_menu_24"
                android:contentDescription="Cart"
                app:tint="#555555"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Cart"
                android:textSize="12sp"
                android:textColor="#555555"/>

        </LinearLayout>


        <!-- ORDERS -->

        <LinearLayout
            android:id="@+id/orders_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/order"
                android:contentDescription="Orders"
                app:tint="#555555"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Orders"
                android:textSize="12sp"
                android:textColor="#555555"/>

        </LinearLayout>


        <!-- PROFILE -->

        <LinearLayout
            android:id="@+id/dashboard_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_dashboard"
                android:contentDescription="Profile"
                app:tint="#555555"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Profile"
                android:textSize="12sp"
                android:textColor="#555555"/>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>