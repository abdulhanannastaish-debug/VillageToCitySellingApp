<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= TOP APP BAR ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#4CAF50"
            android:elevation="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Back Button"
                app:tint="#FFFFFF"/>

            <TextView
                android:id="@+id/tvEditProfileTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Edit Profile"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- ================= PROFILE CARD ================= -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            android:backgroundTint="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">


                <!-- ================= TITLE ================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Update Profile"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center"/>




                <!-- ================= PROFILE IMAGE ================= -->

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="22dp"
                    android:src="@drawable/profile"
                    android:background="@drawable/circle_image_bg"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:contentDescription="Seller Profile Image"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnChangeImage"
                    android:layout_width="170dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:text="Change Image"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/btn_white_rounded"
                    android:backgroundTint="#4CAF50"/>


                <!-- ================= FULL NAME ================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Full Name"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:hint="Enter full name"
                    android:inputType="textCapWords"
                    android:drawableStart="@drawable/ic_profile"
                    android:drawablePadding="8dp"
                    android:paddingStart="12dp"
                    android:background="@drawable/bg_gradient"
                    android:textColor="#000000"
                    android:textColorHint="#777777"/>


                <!-- ================= PHONE ================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Phone Number"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:hint="03XXXXXXXXX"
                    android:inputType="phone"
                    android:drawableStart="@drawable/ic_phone_call"
                    android:drawablePadding="8dp"
                    android:paddingStart="12dp"
                    android:background="@drawable/bg_gradient"
                    android:textColor="#000000"
                    android:textColorHint="#777777"/>


                <!-- ================= EMAIL ================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Email Address"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:hint="Enter email address"
                    android:inputType="textEmailAddress"
                    android:drawableStart="@drawable/ic_email"
                    android:drawablePadding="8dp"
                    android:paddingStart="12dp"
                    android:background="@drawable/bg_gradient"
                    android:textColor="#000000"
                    android:textColorHint="#777777"/>


                <!-- ================= ADDRESS ================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Address"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="8dp"
                    android:hint="Enter complete address"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:drawableStart="@drawable/baseline_home_24"
                    android:drawablePadding="8dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_gradient"
                    android:textColor="#000000"
                    android:textColorHint="#777777"/>


                <!-- ================= CNIC ================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="CNIC Number"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etCnic"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:hint="Enter 13 digit CNIC"
                    android:inputType="number"
                    android:maxLength="13"
                    android:drawableStart="@drawable/ic_cnic"
                    android:drawablePadding="8dp"
                    android:paddingStart="12dp"
                    android:background="@drawable/bg_gradient"
                    android:textColor="#000000"
                    android:textColorHint="#777777"/>


                <!-- ================= BANK ACCOUNT ================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Bank Account Number"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etBankAccount"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:hint="Enter bank account number"
                    android:inputType="number"
                    android:drawableStart="@drawable/ic_bank"
                    android:drawablePadding="8dp"
                    android:paddingStart="12dp"
                    android:background="@drawable/bg_gradient"
                    android:textColor="#000000"
                    android:textColorHint="#777777"/>


                <!-- ================= SAVE BUTTON ================= -->

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="26dp"
                    android:text="Save Changes"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_white_rounded"
                    android:backgroundTint="#4CAF50"/>


                <!-- ================= CANCEL BUTTON ================= -->

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCancel"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:text="Cancel"
                    android:textColor="#4CAF50"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_white_rounded"
                    android:backgroundTint="#E8F5E9"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>