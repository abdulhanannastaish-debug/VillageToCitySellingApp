<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/green"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnTermsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_white"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Terms &amp; Conditions"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ================= CONTENT ================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- ================= INTRO ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Village to City"
                    android:textColor="@color/green"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Seller Terms &amp; Conditions"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Please read these Terms &amp; Conditions carefully before using your seller account on Village to City."
                    android:textColor="#555555"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>


            <!-- ================= SECTION 1 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Seller Account"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="The seller must provide accurate, complete and up-to-date information when creating and maintaining a seller account. The seller is responsible for keeping account information secure and must not share account credentials with unauthorized persons."
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>


            <!-- ================= SECTION 2 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Seller Verification"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Seller verification information, including identity and contact details, must be genuine and belong to the actual seller. Providing false, misleading or fraudulent information may result in rejection, suspension or removal of the seller account."
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>


            <!-- ================= SECTION 3 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Product Listing Rules"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Sellers must provide correct product names, descriptions, prices and other relevant information. Product listings must accurately represent the actual products being offered for sale."
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>


            <!-- ================= SECTION 4 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. Product Quality &amp; Authenticity"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Sellers are responsible for ensuring that products are genuine, safe and accurately described. Fake, counterfeit, misleading, illegal or otherwise prohibited products must not be listed or sold through the platform."
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>


            <!-- ================= SECTION 5 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5. Orders &amp; Delivery"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Sellers are responsible for properly processing customer orders and preparing products for delivery according to the application's order and delivery process. Sellers should cooperate with the applicable courier and delivery procedures."
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>


            <!-- ================= SECTION 6 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="6. Pricing &amp; Payments"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Sellers must provide accurate product prices and must follow the payment, delivery and commission policies applicable to the platform. Any applicable seller payout will be processed according to the platform's payment policy."
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>


            <!-- ================= SECTION 7 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="7. Seller Responsibilities"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Sellers must communicate honestly with customers, maintain accurate product information and fulfill accepted orders responsibly. Sellers must not use the platform for fraudulent, deceptive or unlawful activities."
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>


            <!-- ================= SECTION 8 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="8. Prohibited Activities"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Fraud, impersonation, misleading product information, manipulation of orders, unauthorized use of another person's account and listing prohibited or illegal products are not permitted."
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>


            <!-- ================= SECTION 9 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="9. Account Suspension"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Village to City may suspend, restrict or terminate a seller account if the seller violates these Terms &amp; Conditions, provides false information, engages in fraudulent activity or otherwise misuses the platform."
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>


            <!-- ================= SECTION 10 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="10. Privacy &amp; Personal Information"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Seller information and documents provided during registration and verification should be used only for legitimate platform purposes and handled according to the application's privacy and security practices."
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>


            <!-- ================= SECTION 11 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="11. Changes to Terms"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="These Terms &amp; Conditions may be updated when necessary to reflect changes in the application, services, policies or applicable requirements. Sellers are responsible for reviewing the latest version."
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>


            <!-- ================= SECTION 12 ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="12. Acceptance of Terms"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="By using the Village to City seller platform, you confirm that you have read, understood and agreed to comply with these Terms &amp; Conditions."
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>


            <!-- ================= FOOTER ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Thank you for being a part of Village to City."
                android:textColor="#777777"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>