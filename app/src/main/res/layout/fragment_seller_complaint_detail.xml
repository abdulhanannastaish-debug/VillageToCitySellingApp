<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================================================= -->
        <!-- PAGE TITLE -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seller Complaint Detail"
            android:textColor="#1B1B1B"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- ================================================= -->
        <!-- COMPLAINT CARD -->
        <!-- ================================================= -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true"
            android:backgroundTint="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ========================================= -->
                <!-- SELLER ID LABEL -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seller ID"
                    android:textColor="#777777"
                    android:textSize="13sp" />

                <!-- ========================================= -->
                <!-- SELLER ID -->
                <!-- ========================================= -->

                <TextView
                    android:id="@+id/tvSellerId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SELLER123"
                    android:textColor="#222222"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- ========================================= -->
                <!-- SELLER NAME LABEL -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seller Name"
                    android:textColor="#777777"
                    android:textSize="13sp" />

                <!-- ========================================= -->
                <!-- SELLER NAME -->
                <!-- ========================================= -->

                <TextView
                    android:id="@+id/tvSellerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seller Name"
                    android:textColor="#222222"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- ========================================= -->
                <!-- COMPLAINT DETAIL LABEL -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Complaint Detail"
                    android:textColor="#777777"
                    android:textSize="13sp" />

                <!-- ========================================= -->
                <!-- COMPLAINT DETAIL -->
                <!-- ========================================= -->

                <TextView
                    android:id="@+id/tvComplaintDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Complaint detail will appear here..."
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="24dp" />

                <!-- ========================================= -->
                <!-- ACCEPT BUTTON -->
                <!-- ========================================= -->

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAcceptComplaint"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Accept Complaint"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="#F57C00"
                    android:textAllCaps="false" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>