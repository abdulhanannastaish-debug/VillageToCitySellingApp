<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <!-- ================= GREEN HEADER ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Seller Verification"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="#388E3C"
            android:layout_marginBottom="16dp"
            android:contentDescription="Seller Verification header"/>


        <!-- ================= VERIFICATION STATUS ================= -->

        <TextView
            android:id="@+id/txtVerificationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verification Required"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:padding="12dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="8dp"/>


        <!-- ================= VERIFICATION MESSAGE ================= -->

        <TextView
            android:id="@+id/txtVerificationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please complete your seller verification."
            android:textSize="14sp"
            android:textColor="#555555"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginBottom="16dp"/>


        <!-- ================= SELLER NAME ================= -->

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Seller Name"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>


        <!-- ================= PHONE ================= -->

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Phone (e.g. 03481234567)"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:inputType="phone"
            android:layout_marginBottom="12dp"/>


        <!-- ================= EMAIL ================= -->

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Email"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="12dp"/>


        <!-- ================= ADDRESS ================= -->

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Seller Address"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>


        <!-- ================= CNIC ================= -->

        <EditText
            android:id="@+id/etCnic"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Owner CNIC (13 digits)"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"
            android:inputType="number"
            android:layout_marginBottom="20dp"/>


        <!-- ================= CNIC FRONT ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload CNIC Front Image"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#E0E0E0"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/imgCnicFront"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/camera_icon"
                android:contentDescription="CNIC front image"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to upload"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUploadCnicFront"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Choose CNIC Front Image"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6AC32F"
            android:layout_marginBottom="20dp"/>


        <!-- ================= CNIC BACK ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload CNIC Back Image"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#E0E0E0"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/imgCnicBack"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/camera_icon"
                android:contentDescription="CNIC back image"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to upload"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUploadCnicBack"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Choose CNIC Back Image"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6AC32F"
            android:layout_marginBottom="24dp"/>


        <!-- ================= SUBMIT ================= -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Register as Seller"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#6AC32F"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>