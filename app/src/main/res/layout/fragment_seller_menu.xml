<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#F2F4F7"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= Top Header ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/appbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@android:color/black"/>
    </LinearLayout>

    <!-- ================= Add New Item Button ================= -->
    <Button
        android:id="@+id/btn_add_item"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:backgroundTint="#4CAF50"
        android:text="@string/add_new_item"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:drawablePadding="8dp"
        android:gravity="center" />

    <!-- ================= Items List ================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_menu_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="this is recycler view so add here *item_menu.xml for seing your added items"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You need an Adapter class to bind your menu data to the RecyclerView:"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="when click on add new item then show *seller_menu_add_item* to done this add click lisner in seller_fragment_menu on add new item button , and in click listner add code to access *seller_menu_item.xml* file"/>
</LinearLayout>