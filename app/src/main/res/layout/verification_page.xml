<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verification Page"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp"/>

        <!-- SELLER NAME -->

        <EditText
            android:id="@+id/etSellerName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Seller Name"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"/>

        <!-- PHONE NUMBER -->

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:hint="Phone Number"
            android:inputType="phone"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"/>

        <!-- CNIC NUMBER -->

        <EditText
            android:id="@+id/etCnic"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:hint="CNIC Number"
            android:inputType="number"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"/>

        <!-- CNIC IMAGE -->

        <Button
            android:id="@+id/btnCnicImage"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:text="Upload CNIC Image"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#4CAF50"/>

        <!-- LOCATION -->

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:hint="Location"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"/>

        <!-- ACCOUNT DETAIL -->

        <EditText
            android:id="@+id/etAccountDetail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:hint="Account Detail"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"/>

        <!-- SIGNUP BUTTON -->

        <Button
            android:id="@+id/btnSignup"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:text="Create Seller Account"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#4FAF4C"/>

        <!-- LOGIN TEXT -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? Login"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>



    </LinearLayout>


</ScrollView>
