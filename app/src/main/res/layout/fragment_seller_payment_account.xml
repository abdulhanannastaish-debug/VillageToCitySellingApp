<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- ================= PAGE TITLE ================= -->

    <TextView
        android:id="@+id/txtPaymentAccountTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Payment Account"
        android:textColor="#000000"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />


    <!-- ================= PAYMENT ACCOUNT CARD ================= -->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="5dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Section Title -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Account Details"
                android:textColor="#000000"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />


            <!-- ================= PAYMENT METHOD ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Payment Method"
                android:textColor="#555555"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/paymentMethodGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radioBank"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Bank Account"
                    android:textColor="#000000"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioEasypaisa"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Easypaisa"
                    android:textColor="#000000"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioJazzCash"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="JazzCash"
                    android:textColor="#000000"
                    android:textSize="15sp" />

            </RadioGroup>


            <!-- ================= ACCOUNT HOLDER ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Account Holder Name"
                android:textColor="#555555"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtAccountName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:hint="Enter account holder name"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:inputType="textPersonName"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_gradient" />


            <!-- ================= ACCOUNT NUMBER ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Account / Mobile Number"
                android:textColor="#555555"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtAccountNumber"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:hint="Enter account or mobile number"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:inputType="phone"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_gradient" />


            <!-- ================= BANK NAME ================= -->

            <TextView
                android:id="@+id/txtBankNameLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Bank Name"
                android:textColor="#555555"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtBankName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:hint="Enter bank name"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_gradient" />


            <!-- ================= SAVE BUTTON ================= -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSavePaymentAccount"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="25dp"
                android:text="Save Payment Account"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/btn_white_rounded"
                android:backgroundTint="#4CAF50" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- ================= NOTE ================= -->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="#FFFFFF">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Note: Please make sure your account details are correct. Your earnings will be sent to the saved account automatically."
            android:textColor="#666666"
            android:textSize="13sp" />

    </androidx.cardview.widget.CardView>

</LinearLayout>