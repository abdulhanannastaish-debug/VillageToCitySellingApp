<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/camerasmall"
        android:roundIcon="@mipmap/camerasmall_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VillageToCityReseilingApp"
        tools:targetApi="31">

        <!-- Logo -->
        <activity
            android:name="com.example.marketplace.activity.LogoActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Splash -->
        <activity
            android:name="com.example.marketplace.activity.Splash"
            android:exported="false" />

        <!-- Login / Signup -->
        <activity
            android:name="com.example.marketplace.activity.AuthActivity"
            android:exported="false" />

        <!-- Buyer -->
        <activity
            android:name="com.example.marketplace.activity.buyer_MainActivity"
            android:exported="false" />

        <!-- Seller -->
        <activity
            android:name="com.example.marketplace.activity.seller_MainActivity"
            android:exported="false" />

    </application>

</manifest>